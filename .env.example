# JOURNOVA ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT hardcode secrets in .env files committed to git!
# Copy this file to `.env` or `.env.local` based on your environment.

# ========================================================
# DATABASE (packages/database & apps/api)
# ========================================================
# Neon PostgreSQL URL (Connection pooling recommended for serverless)
# NOTE FOR PRODUCTION: Add `?pgbouncer=true&connection_limit=5&pool_timeout=10` to the URL.
DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connection_limit=5&pool_timeout=10"

# ========================================================
# BACKEND API (apps/api)
# ========================================================
# Environment Mode: development, production, test
NODE_ENV="development"
PORT=3001

# JWT Secrets (Must be exactly 32+ characters in production)
JWT_SECRET="replace-with-a-very-long-secure-random-string-for-jwt"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Frontend Origin Configuration
# Allowlist for CORS (comma separated for multiple origins)
# For production, DO NOT use wildcard or localhost
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_URL="http://localhost:3000"

# Cookie Security Settings
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=""

# Storage Configuration (S3/R2 prep)
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""

# ========================================================
# FRONTEND WEB (apps/web)
# ========================================================
# API Base URL that the frontend will call
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
