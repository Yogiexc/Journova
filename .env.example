# JOURNOVA ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT hardcode secrets in .env files committed to git!
# Copy this file to `.env` or `.env.local` based on your environment.

# ========================================================
# DATABASE (packages/database & apps/api)
# ========================================================
# Neon PostgreSQL URL (Connection pooling recommended)
DATABASE_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"

# ========================================================
# BACKEND API (apps/api)
# ========================================================
# Environment Mode: development, production, test
NODE_ENV="development"
PORT=3001

# JWT Secrets (Must be exactly 32+ characters in production)
JWT_SECRET="replace-with-a-very-long-secure-random-string-for-jwt"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS & Frontend Origin Configuration
# Allowlist for CORS (comma separated for multiple origins)
# For production, DO NOT use wildcard or localhost
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_URL="http://localhost:3000"

# ========================================================
# FRONTEND WEB (apps/web)
# ========================================================
# API Base URL that the frontend will call
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
