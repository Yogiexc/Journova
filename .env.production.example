# JOURNOVA PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# Salin ke server produksi atau platform hosting (misal: Railway, Render, Vercel, VPS).
# JANGAN PERNAH COMMIT FILE .env.production ASLI YANG BERISI CREDENTIALS RAHASIA KE GIT!

# ========================================================
# DATABASE (Neon PostgreSQL Production)
# ========================================================
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connection_limit=10"

# ========================================================
# BACKEND API (apps/api)
# ========================================================
NODE_ENV="production"
PORT=3001

# JWT Secrets (Wajib 32+ karakter acak yang kuat)
JWT_SECRET="generate-a-very-long-production-jwt-secret-key-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Domain & CORS Origins (Hanya domain produksi yang diizinkan)
CORS_ORIGINS="https://journova.com,https://www.journova.com"
FRONTEND_URL="https://journova.com"

# Cookie Security Settings (Aktifkan secure cookie di HTTPS)
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=".journova.com"

# Cloudflare R2 Object Storage
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="journova-storage"

# Crossref DOI Production Integration
CROSSREF_DEPOSIT_MODE="live"
CROSSREF_ENDPOINT="https://doi.crossref.org/servlet/deposit"
CROSSREF_USERNAME="your-crossref-username"
CROSSREF_PASSWORD="your-crossref-password"

# ========================================================
# FRONTEND WEB (apps/web)
# ========================================================
NEXT_PUBLIC_APP_URL="https://journova.com"
NEXT_PUBLIC_API_URL="https://api.journova.com/api/v1"
